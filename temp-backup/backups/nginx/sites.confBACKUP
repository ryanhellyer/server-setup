server {
    listen 80;
    listen [::]:80;
    server_name _;

    # Let's Encrypt verification path
    location ~ /.well-known/acme-challenge/ {
        allow all;
        root /var/www/acme;
        try_files $uri =404;
    }

    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 80;
    listen [::]:80;

    server_name pressabl12.hellyer.kiwi;
    root /var/www/pressabl12.hellyer.kiwi/public;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
}

