##
# Redirect all http requests to http.
#
server {
    listen 80;
    listen [::]:80;
    server_name _;
#    server_name pressabl12.hellyer.kiwi stuff.hellyer.kiwi;

    # Use specific directory for letsencrypt authentication.
    location ~ /.well-known/acme-challenge/ {
        allow all;
        root /var/www/acme;
        try_files $uri =404;
    }

    # For all other requests
    location / {
        return 301 https://$host$request_uri;
    }
}
