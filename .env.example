# Copy to .env and fill in real values. NEVER commit .env.

# ---- Deployment mode ----
# test        = small test box: Valkey capped at 64 MB, real TLS only for
#               the test domain(s) in CERTBOT_DOMAINS_FILE, fake placeholder
#               sites + temporary self-signed certs for every domain (no
#               manual code removal needed before going to production).
# production  = full stack, real certs for every domain, no fake content.
DEPLOY_ENV=test

# Nginx fastcgi cache keys_zone (RAM for cache keys).
# 64m is plenty for a test box; 500m on production with lots of traffic.
FASTCGI_CACHE_SIZE=64m

# ---- MariaDB sizing ----
# Roughly 1/8 of host RAM is a good starting point: 1G on an 8 GB box,
# 8G on a 16 GB box. The InnoDB buffer pool is the biggest DB perf lever.
MARIADB_BUFFER_POOL=1g
MARIADB_LOG_SIZE=64m

# ---- PHP-FPM sizing ----
# Test (2 GB): 20 children / 128M each. Production (16 GB, 8 cores):
#   PHP_FPM_MAX_CHILDREN=50, PHP_FPM_MEMORY_LIMIT=256M
PHP_FPM_MAX_CHILDREN=20
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE=4
PHP_FPM_MAX_SPARE=10
PHP_FPM_MEMORY_LIMIT=128M

# ---- Database ----
MARIADB_ROOT_PASSWORD=change-me-strong-password

# ---- Let's Encrypt ----
CERTBOT_EMAIL=admin@hellyer.kiwi
# Which cert list to issue (test = only the test domain(s)).
CERTBOT_DOMAINS_FILE=certbot/domains.test.txt

# ---- Valkey (drop-in Redis replacement) ----
# Test server: 64 MB. Raise to 1024mb on the production box.
VALKEY_MAXMEMORY=64mb

# ---- Swap (small boxes only) ----
# A 2G swapfile is created automatically on hosts with no swap. Production
# with plenty of RAM can leave this alone.
SWAP_SIZE=2G

# ---- Site files ----
# Host location of the web roots. Defaults to the admin user's home (~/www),
# e.g. /home/ryan/www, which keeps the data on the home partition (friendlier
# to atomic/immutable distros like Fedora Silverblue). It is bind-mounted into
# the containers at /var/www, so the nginx config is unaffected.
#WWW_ROOT=/home/ryan/www

# Host location of the per-site nginx logs. Defaults to the admin user's home
# (~/logs), deliberately OUTSIDE the web roots so site backups/snapshots never
# include logs. Bind-mounted into nginx at /var/log/sites and rotated hourly by
# server-logs.timer (50M cap, 14 compressed generations).
#LOG_ROOT=/home/ryan/logs

# ---- Non-site files ("extras") ----
# Everything in the snapshot that is NOT a website (backup scripts, configs,
# cron, old site copies, misc data) is copied into this host directory by
# provision-extras.sh. Defaults to the admin user's home (~/tools).
#TOOLS_ROOT=/home/ryan/tools
# Space-separated top-level snapshot names to skip when copying extras.
#EXTRAS_EXCLUDE=
# Set to 0 to skip the extras copy entirely.
#PROVISION_EXTRAS=1

# ---- Remote storage (snapshots, DB dumps, backups) ----
# Generic SFTP/rsync storage (Hetzner Storage Box today). One key
# (~/.ssh/id_ed25519, generated by host-setup.sh) is used for the mounts and
# the snapshot sync; storage-mounts.sh authorises it on both boxes once.
STORAGE_USER=u513410
STORAGE_HOST=u513410.your-storagebox.de
STORAGE_PORT=23
#STORAGE_KEY=/home/ryan/.ssh/id_ed25519

# Dated snapshot root of the old /var/www on the storage box. The newest dated
# dir under here is used for site files + the Open WebUI data. Pin SNAPSHOT_DIR
# to force a specific date.
SNAPSHOT_ROOT=/home/pressabl
#SNAPSHOT_DIR=/home/pressabl/2026-09-20
# Rename snapshot dirs to local dirs (space-separated src=dst). Used to test a
# site under a different domain before DNS moves.
SNAPSHOT_RENAMES="spam-destroyer.com=spam-destroyer.hellyer.kiwi"

# Local directory holding the MySQL dumps (written by scripts/backup.sh, then
# synced to the storage box). Defaults to the admin user's ~/mariadbs.
DB_DUMP_DIR=/home/ryan/mariadbs

# ---- Off-site backups (pressabl-backups / Hetzner u676107) ----
# Direct `rsync --link-dest` dated snapshots, one chain per source under
# $BACKUP_REMOTE_BASE/{www,tools,mariadbs,gmail,server-setup}/<YYYY-MM-DD>/.
# NOTE: this is a DIFFERENT box from the STORAGE_* snapshot source above
# (u513410, the old server's box, read-only). The new server writes here only.
# BACKUP_ENABLED=0 disables entirely (e.g. on a test box that must not write).
BACKUP_ENABLED=1
BACKUP_USER=u676107
BACKUP_HOST=u676107.your-storagebox.de
BACKUP_PORT=23
# Key defaults to the server's standard key (~/.ssh/id_ed25519). It is
# authorised on this box by scripts/storage-mounts.sh (asked once).
#BACKUP_KEY=/home/ryan/.ssh/id_ed25519
BACKUP_REMOTE_BASE=/home
# Day-of-week for the MySQL dumps (1=Mon..7=Sun); file snapshots run daily.
BACKUP_WEEKLY_DAY=1
# Optional snapshot pruning (unset = keep all). With KEEP_MONTHLY>0, first-of-
# month snapshots are kept regardless of age.
#BACKUP_KEEP_DAYS=90
#BACKUP_KEEP_MONTHLY=6
# Repo root to back up (defaults to this checkout):
#SERVER_SETUP_ROOT=/home/ryan/server-setup

# ---- Storage boxes to mount (scripts/storage-mounts.sh) ----
# Passwordless access to all three boxes; the primary box's /home/gmail and
# /home/databases are mounted at ~/gmail and ~/mariadbs via sshfs. The
# secondary box is authorised but not mounted. Defaults already match.
#STORAGE_PRIMARY_HOST=u458814.your-storagebox.de
#STORAGE_PRIMARY_USER=u458814
#STORAGE_SECONDARY_HOST=u513410.your-storagebox.de
#STORAGE_SECONDARY_USER=u513410
# The backup box (u676107) is authorised too, using BACKUP_HOST/BACKUP_USER
# from the off-site backups block above; it is never mounted.
# Target home for the mounts (default: the invoking user's home, e.g. /home/ryan)
#STORAGE_MOUNT_HOME=

# ---- Open WebUI (chat.hellyer.kiwi) ----
# Public URL of the Open WebUI instance (passed to the container as WEBUI_URL).
OPENWEBUI_URL=https://chat.hellyer.kiwi
# OpenRouter API key for Open WebUI. Left blank here; provision-openwebui.sh
# fills it from the old install.sh on the storage box. NEVER commit a real key.
OPENROUTER_API_KEY=

# ---- Gmail fetching (scripts/getmail.sh) ----
# Fetch mail from Gmail into a Maildir via getmail6, run daily by
# server-getmail.timer. GMAIL_APP_PASSWORD is a Google app password
# (Google Account -> Security -> App passwords), NOT your normal password.
# Use the 16-character form without spaces (spaces are stripped anyway, but an
# unquoted value with spaces would break `.env` sourcing). Leave blank to skip
# getmail (the daily timer then no-ops).
GMAIL_USER=ryanhellyer@gmail.com
GMAIL_APP_PASSWORD=
# Maildir to deliver into (default: the admin user's ~/gmail, usually the
# sshfs mount of the storage box's /home/gmail share).
#GMAIL_MAILDIR=/home/ryan/gmail
# Optional override: IMAP mailboxes, "|"-separated. Defaults to the legacy list.
#GMAIL_MAILBOXES=Inbox|[Gmail]/Sent Mail|Contact form|Financial|Insurance|Landlord|Medical|Payments|Pension|Postal mail|Potentially tax relevant

# ---- Laravel scheduler (scripts/laravel-scheduler.sh) ----
# Space-separated list of Laravel sites whose `artisan schedule:run` is ticked
# every minute by server-scheduler.timer. Set to empty to disable the job.
LARAVEL_SCHEDULER_SITES="spam-destroyer.com kartastrophecup.de"

# ---- Laravel queue workers (scripts/install-systemd.sh) ----
# Space-separated list of Laravel sites to run a supervised
# `php artisan queue:work database` process for. One systemd service per site.
# Set to empty to run no workers.
QUEUE_WORKER_SITES=kartastrophecup.de

# ---- WordPress multisite cron (scripts/wp-cron.sh) ----
# Web root of the WordPress multisite, as seen INSIDE the containers. The
# script runs all due WP-Cron events for every site, every minute, via
# server-wpcron.timer.
WP_CRON_PATH=/var/www/pressabl/public_html

# ---- Site secrets (used by scripts/new-site.sh) ----
# One entry per site, injected at site-creation time.
# SITE_DB_PASSWORD_<DOMAIN>=...   (generated by new-site.sh into this file)