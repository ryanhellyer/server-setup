# mailrelay — catch-all SMTP sink that forwards every message to Telegram.
#
# See EMAILS.md (repo root). One small Python service: aiosmtpd accepts SMTP on
# :25 (no auth; reachable only on the compose `web` network and a
# localhost-published host port), spools each message to disk, and forwards it
# to the Telegram Bot API with retries.
#
# It must run on a network with outbound internet (the `web` network) so it can
# reach api.telegram.org. Configuration is via TELEGRAM_* / MAIL_* env vars
# (compose.yaml); no secrets are baked into the image.

FROM docker.io/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# python3-aiosmtpd is packaged for noble; fall back to pip if the universe
# package is unavailable on the mirror.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 ca-certificates \
    && ( apt-get install -y --no-install-recommends python3-aiosmtpd \
         || ( apt-get update \
              && apt-get install -y --no-install-recommends python3-pip \
              && pip3 install --no-cache-dir --break-system-packages aiosmtpd ) ) \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY gateway.py /app/gateway.py

WORKDIR /app

EXPOSE 25 8080

CMD ["python3", "/app/gateway.py"]
