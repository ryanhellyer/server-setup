# Node.js container — base image only.
# Node apps (chat.hellyer.kiwi currently) are bind-mounted from /var/www.
#
# chat.hellyer.kiwi runs on port 3000 (see the node-app upstream in nginx.conf).
# To run a different app, override the command in compose.yaml, e.g.:
#   command: ["node", "/var/www/myapp/server.js"]
#
# The entrypoint runs /var/www/server.js if present, otherwise idles — so the
# base container stays up (and does not crash-loop) when no app is deployed yet.

FROM docker.io/node:22-slim

WORKDIR /var/www

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []