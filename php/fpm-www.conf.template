; Single shared FPM pool. The socket is exposed to the nginx container
; through the shared `php-socket` volume (see compose.yaml).
; Sizing is env-driven (PHP_FPM_MAX_CHILDREN / START / MIN / MAX_SPARE /
; MEMORY_LIMIT in .env; rendered by scripts/render-config.sh).
[www]
user = www-data
group = www-data

; NOTE: there is no `umask` directive in FPM pool config (php-fpm refuses to
; start on it). The group-write umask (0002) so PHP-created files land as
; 664/775 and stay editable by the www-data group is set in the container CMD
; instead (see php/Containerfile).

listen = /run/php/php8.5-fpm.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660

pm = dynamic
pm.max_children = __PHP_FPM_MAX_CHILDREN__
pm.start_servers = __PHP_FPM_START_SERVERS__
pm.min_spare_servers = __PHP_FPM_MIN_SPARE__
pm.max_spare_servers = __PHP_FPM_MAX_SPARE__
pm.max_requests = 500

; Allow the socket to be shared with the nginx container over the volume.
listen.allowed_clients = 127.0.0.1

; Buffers/logging.
request_terminate_timeout = 300s
catch_workers_output = no
php_admin_value[memory_limit] = __PHP_FPM_MEMORY_LIMIT__
php_admin_value[upload_max_filesize] = 64M
php_admin_value[post_max_size] = 64M