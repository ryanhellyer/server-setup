# mailrelay shim (EMAILS.md) — baked into the PHP image at /etc/msmtprc.
# /usr/sbin/sendmail is provided by msmtp-mta and relays here. Internal compose
# network only: no auth, no TLS. No secrets.
defaults
auth           off
tls            off
syslog         LOG_MAIL

account        mailrelay
host           mailrelay
port           25
from           server@hellyer.kiwi

account        default : mailrelay
